node_modules/
out/
dist/
*.log
.DS_Store

# Source bundles produced for handing the project to another machine — a build
# output, not an input, and re-creatable at any time.
Slate-mac-source.zip

# Rust / napi-rs build caches (native/*/target)
native/*/target/

# napi-rs renames the previous .node out of the way while relinking and leaves
# the placeholder behind when the build is interrupted. They accumulate one per
# aborted build and are never inputs to anything.
native/*/..*.retired.tmp.*
native/*/*.retired.tmp.*

# Editor / OS noise
.vscode/
Thumbs.db
desktop.ini

# Local state and quarantined store files
*.bak
*.corrupt-*
.workspace/

# The dev profile the app runs against (`dev.bat`). It holds the embedded
# browser's real cookies and cache — including Google's location cookie — so
# committing it would publish the developer's own browsing state.
.dev-user-data/
.staging/

# Secrets for local dev — never committed. See main/index.ts's dotenv load.
.env
.env.local

# Agent client configs the app writes into the workspace on startup
# (mcpAutoConfig.ts). They embed this installation's control token, which is
# what opens shells and drives the command bus — same trust level as .env.
# Every one of them is regenerated automatically, so ignoring them loses
# nothing. The list has to cover all of them: .mcp.json and opencode.json were
# ignored while the Cursor/Grok/Gemini/agents copies stayed tracked, which put
# a live token in the repository.
.mcp.json
/opencode.json
.agents/
.cursor/
.gemini/
.grok/
.kimi/
.windsurf/
.antigravity/
.claude/

# Playwright E2E output
test-results/
test-results-*/
playwright-report/
playwright/.cache/

# Rust build output
native/target/
native/pty-core/
native/*/*.node

# Audit screens & temporary review outputs
.audit-screens*/
.ui-review/
typescript-errors.txt

# Local reference clones, not part of the app
/reference/
native/target
